{
  "name": "ptcg-sim",
  "version": "1.5.1",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "pnpm -C server start",
    "build": "tsc -b server && pnpm -C client build",
    "clean": "rm -rf server/dist client/dist client/storybook-static",
    "lint": "pnpm -C server lint && pnpm -C client lint",
    "format": "pnpm -C server format && pnpm -C client format"
  },
  "devDependencies": {
    "globals": "^15.14.0",
    "nodemon": "^3.1.9"
  },
  "packageManager": "pnpm@10.13.1"
}
